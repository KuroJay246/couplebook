{
  "name": "memorybook",
  "version": "3.0.0",
  "description": "Relationship Memory System for Jaylan and Omia",
  "main": "index.html",
  "scripts": {
    "dev": "node server.js",
    "check:routes": "node scripts/qa/check-routes.js",
    "check:privacy": "node scripts/qa/check-privacy.js",
    "check:safety": "node scripts/qa/check-safety.js",
    "check:public": "node scripts/qa/check-public.js",
    "check:rules": "node scripts/qa/check-rules.js",
    "check:mirrors": "node scripts/qa/check-mirrors.js",
    "check:services": "node scripts/qa/check-services.js",
    "check:sync-model": "node scripts/qa/check-sync-model.js",
    "check:prototype": "node scripts/qa/check-prototype.js",
    "check:docs": "node scripts/qa/check-docs.js",
    "check:all": "node scripts/qa/check-all.js",
    "docs:check": "node scripts/qa/check-docs.js",
    "app:v2:dev": "npm --prefix app-v2 run dev",
    "app:v2:build": "npm --prefix app-v2 run build",
    "app:v2:test": "npm --prefix app-v2 test",
    "eventhub:status": "node scripts/eventhub-status.mjs",
    "eventhub:compare": "node scripts/eventhub-compare.mjs",
    "product:qa": "node scripts/product-qa.mjs",
    "product:audit": "node scripts/product-audit.mjs",
    "alignment:check": "node scripts/check-event-hub-alignment.mjs",
    "release:preflight": "set EXPECTED_FIREBASE_PROJECT_ID=couplebook-97830&& node scripts/assert-firebase-project.mjs --project couplebook-97830 && npm run docs:check"
  },
  "keywords": [
    "relationship",
    "timeline",
    "memories",
    "glassmorphism"
