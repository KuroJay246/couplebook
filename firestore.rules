rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Authoritative Data Model - app-v2 protected Couple Book
    // ===============================================================
    //
    // users/{uid}: approved-user authorization document. Client read is owner
    // only; client writes are denied. Production access also requires
    // accessStatus == "active"; pending accounts are retained but denied.
    //
    // couples/{coupleId}: shared couple metadata. Client read is active-member
    // only; client writes are denied.
    //
    // couples/{coupleId}/members/{uid}: active membership document. Client read
    // is own-member only; client writes are denied.
    //
    // couples/{coupleId}/profiles/{uid}
    //   schemaVersion: 1
    //   name: string, 1..80
    //   bio: string, <=500
    //   anniversaryView: string, <=40
    //   joinedDate: string YYYY-MM-DD or empty
    //   birthday: string YYYY-MM-DD or empty
    //
    // couples/{coupleId}/favorites/{uid}
    //   schemaVersion: 1
    //   food/songs/movies/places/memories/notes: list, <=50
    //
    // couples/{coupleId}/settings/{uid}
    //   schemaVersion: 1
    //   appearanceTheme: midnight-rose|paper-hearts|moonlit
    //   anniversaryView: string, <=40
    //   privacy.localOnlyMode: bool
    //   privacy.reducedMotion: bool
    //
    // couples/{coupleId}/contracts/current
    //   schemaVersion: 1
    //   title: optional string <=160
    //   bodyStatus: optional string <=60
    //   acceptedBy: list <=2
    //   signatureStatus: status-only|not-connected
    //
    // couples/{coupleId}/memories/{memoryId}
    //   schemaVersion: 1
    //   title: string, 1..180
    //   description: string, <=2000
    //   date: string YYYY-MM-DD
    //   tags: list <=30
    //   mediaState: none|private-legacy-reference|storage-verified
    //   media: optional map for verified Storage media only
    //   specialMomentType: optional ordinary|birthday|valentine|confession
    //   status: active|archived
    //   createdBy/updatedBy: uid strings
    //
    // couples/{coupleId}/specialMoments/{birthday|valentine|confession}
    //   schemaVersion: 1
    //   title: string, 1..120
    //   subtitle: string, <=180
    //   date: string YYYY-MM-DD or empty
    //   sections: list <=8, validated structurally in app service
    // ===============================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwnUser(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function userDocPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function memberDocPath(coupleId, uid) {
      return /databases/$(database)/documents/couples/$(coupleId)/members/$(uid);
    }

    function memoryDocPath(coupleId, memoryId) {
      return /databases/$(database)/documents/couples/$(coupleId)/memories/$(memoryId);
    }

    function isActiveApprovedUserForCouple(coupleId) {
      return isSignedIn()
        && exists(userDocPath(request.auth.uid))
        && get(userDocPath(request.auth.uid)).data.approved == true
        && get(userDocPath(request.auth.uid)).data.accessStatus == 'active'
        && get(userDocPath(request.auth.uid)).data.coupleId == coupleId;
    }

    function isActiveCoupleMember(coupleId) {
      return isActiveApprovedUserForCouple(coupleId)
        && exists(memberDocPath(coupleId, request.auth.uid))
        && get(memberDocPath(coupleId, request.auth.uid)).data.active == true
        && get(memberDocPath(coupleId, request.auth.uid)).data.role == 'member';
    }

    function isApprovedMomentType(momentType) {
      return momentType in ['birthday', 'valentine', 'confession'];
    }

    function hasOnly(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function hasAll(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function isSafeString(value, maxSize) {
      return value is string
        && value.size() <= maxSize
        && !value.matches('.*(<[^>]+>|javascript:|on[a-z]+\\s*=|script|iframe|object|embed).*');
    }

    function isRequiredSafeString(value, maxSize) {
      return isSafeString(value, maxSize) && value.size() > 0;
    }

    function isDateOrEmpty(value) {
      return value is string && (value == '' || value.matches('^\\d{4}-\\d{2}-\\d{2}$'));
    }

    function isStringList(value, maxSize) {
      return value is list && value.size() <= maxSize;
    }

    function isOptionalTimestamp(value) {
      return !(value is timestamp) ? false : true;
    }

    function hasOptionalMetadata() {
      return (!('createdAt' in request.resource.data)
          || (
            request.resource.data.createdAt is timestamp
            && (
              resource == null
              || !('createdAt' in resource.data)
              || request.resource.data.createdAt == resource.data.createdAt
            )
          ))
        && (!('updatedAt' in request.resource.data) || request.resource.data.updatedAt is timestamp)
        && (!('createdBy' in request.resource.data)
          || request.resource.data.createdBy == (
            resource == null || !('createdBy' in resource.data)
              ? request.auth.uid
              : resource.data.createdBy
          ))
        && (!('updatedBy' in request.resource.data) || request.resource.data.updatedBy == request.auth.uid);
    }

    function currentRevision() {
      return resource == null || !(resource.data.get('revision', 0) is int) ? 0 : resource.data.get('revision', 0);
    }

    function hasNextRevision() {
      return request.resource.data.revision is int
        && request.resource.data.revision >= 1
        && request.resource.data.revision == currentRevision() + 1;
    }

    function existingPlanCreatedBy() {
      return resource != null && resource.data.createdBy is string
        ? resource.data.createdBy
        : request.auth.uid;
    }

    function existingPlanCreatedAt() {
      return resource != null && resource.data.createdAt is timestamp
        ? resource.data.createdAt
        : request.resource.data.createdAt;
    }

    function existingPlanConvertedMemoryId() {
      return resource != null && resource.data.convertedMemoryId is string
        ? resource.data.convertedMemoryId
        : '';
    }

    function isValidProfile(uid) {
      return isOwnUser(uid)
        && hasOnly(['schemaVersion', 'revision', 'name', 'bio', 'anniversaryView', 'joinedDate', 'birthday', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
        && hasAll(['schemaVersion', 'revision', 'name'])
        && request.resource.data.schemaVersion == 1
        && hasNextRevision()
        && isRequiredSafeString(request.resource.data.name, 80)
        && (!('bio' in request.resource.data) || isSafeString(request.resource.data.bio, 500))
        && (!('anniversaryView' in request.resource.data) || isSafeString(request.resource.data.anniversaryView, 40))
        && (!('joinedDate' in request.resource.data) || isDateOrEmpty(request.resource.data.joinedDate))
        && (!('birthday' in request.resource.data) || isDateOrEmpty(request.resource.data.birthday))
        && hasOptionalMetadata();
    }

    function isValidFavorites(uid) {
      return isOwnUser(uid)
        && hasOnly(['schemaVersion', 'revision', 'food', 'songs', 'movies', 'places', 'memories', 'notes'])
        && request.resource.data.schemaVersion == 1
        && hasNextRevision()
        && (!('food' in request.resource.data) || isStringList(request.resource.data.food, 50))
        && (!('songs' in request.resource.data) || isStringList(request.resource.data.songs, 50))
        && (!('movies' in request.resource.data) || isStringList(request.resource.data.movies, 50))
        && (!('places' in request.resource.data) || isStringList(request.resource.data.places, 50))
        && (!('memories' in request.resource.data) || isStringList(request.resource.data.memories, 50))
        && (!('notes' in request.resource.data) || isStringList(request.resource.data.notes, 50));
    }

    function isValidPrivateSettings(uid) {
      return isOwnUser(uid)
        && hasOnly(['schemaVersion', 'revision', 'appearanceTheme', 'theme', 'anniversaryView', 'preferredAlbumView', 'privacy', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
        && request.resource.data.schemaVersion == 1
        && hasNextRevision()
        && (
          ('appearanceTheme' in request.resource.data && request.resource.data.appearanceTheme in ['midnight-rose', 'paper-hearts', 'moonlit'])
          || ('theme' in request.resource.data && request.resource.data.theme in ['paper', 'rose', 'olive', 'plum'])
        )
        && (!('anniversaryView' in request.resource.data) || isSafeString(request.resource.data.anniversaryView, 40))
        && (!('preferredAlbumView' in request.resource.data) || request.resource.data.preferredAlbumView in ['photo-book', 'all-memories'])
        && request.resource.data.privacy is map
        && request.resource.data.privacy.keys().hasOnly(['localOnlyMode', 'reducedMotion'])
        && request.resource.data.privacy.localOnlyMode is bool
        && request.resource.data.privacy.reducedMotion is bool
        && hasOptionalMetadata();
    }

    function isValidSharedSettings() {
      return hasOnly(['schemaVersion', 'revision', 'appearanceTheme', 'theme', 'anniversaryView', 'preferredAlbumView', 'liveAlbumCover', 'previewOrder', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
        && hasAll(['schemaVersion', 'revision'])
        && request.resource.data.schemaVersion == 1
        && hasNextRevision()
        && (!('appearanceTheme' in request.resource.data) || request.resource.data.appearanceTheme in ['midnight-rose', 'paper-hearts', 'moonlit'])
        && (!('theme' in request.resource.data) || request.resource.data.theme in ['paper', 'rose', 'olive', 'plum'])
        && (!('anniversaryView' in request.resource.data) || isSafeString(request.resource.data.anniversaryView, 40))
        && (!('preferredAlbumView' in request.resource.data) || request.resource.data.preferredAlbumView in ['photo-book', 'all-memories'])
        && (!('liveAlbumCover' in request.resource.data) || isSafeString(request.resource.data.liveAlbumCover, 260))
        && (!('previewOrder' in request.resource.data) || isStringList(request.resource.data.previewOrder, 12))
        && hasOptionalMetadata();
    }

    function isValidMemory() {
      return hasOnly(['schemaVersion', 'revision', 'title', 'description', 'date', 'caption', 'tags', 'kindLabel', 'mediaNote', 'mediaState', 'mediaType', 'media', 'linkedPlanId', 'specialMomentType', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy', 'status'])
        && hasAll(['schemaVersion', 'revision', 'title', 'date', 'mediaState', 'createdBy', 'updatedBy', 'status'])
        && request.resource.data.schemaVersion == 1
        && hasNextRevision()
        && isRequiredSafeString(request.resource.data.title, 180)
        && (!('description' in request.resource.data) || isSafeString(request.resource.data.description, 2000))
        && request.resource.data.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && (!('caption' in request.resource.data) || isSafeString(request.resource.data.caption, 300))
        && (!('tags' in request.resource.data) || isStringList(request.resource.data.tags, 30))
        && (!('kindLabel' in request.resource.data) || request.resource.data.kindLabel in ['Everyday Moment', 'Date', 'First', 'Trip', 'Milestone', 'Celebration', 'Funny Moment', 'Note', 'Photo Memory', 'Video Memory'])
        && (!('mediaNote' in request.resource.data) || isSafeString(request.resource.data.mediaNote, 300))
        && request.resource.data.mediaState in ['none', 'private-legacy-reference', 'storage-verified', 'drive-verified']
        && (!('mediaType' in request.resource.data) || request.resource.data.mediaType in ['text', 'photo', 'video', 'milestone'])
        && (
          request.resource.data.mediaState in ['storage-verified', 'drive-verified']
            ? ('media' in request.resource.data && isValidMediaMetadata(request.resource.data.media, request.resource.data.mediaState))
            : !('media' in request.resource.data)
        )
        && (!('linkedPlanId' in request.resource.data) || isSafeString(request.resource.data.linkedPlanId, 120))
        && (!('specialMomentType' in request.resource.data) || request.resource.data.specialMomentType in ['ordinary', 'birthday', 'valentine', 'confession', 'milestone'])
        && request.resource.data.createdBy == (
          resource == null || !('createdBy' in resource.data)
            ? request.auth.uid
            : resource.data.createdBy
        )
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.status in ['active', 'archived']
        && hasOptionalMetadata();
    }

    function isValidPlan() {
      return hasOnly(['schemaVersion', 'revision', 'title', 'category', 'status', 'targetDate', 'notes', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt', 'convertedMemoryId'])
        && hasAll(['schemaVersion', 'revision', 'title', 'category', 'status', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt'])
        && request.resource.data.schemaVersion == 1
        && hasNextRevision()
        && isRequiredSafeString(request.resource.data.title, 160)
        && request.resource.data.category in ['Date Idea', 'Place to Visit', 'Restaurant', 'Movie or Show', 'Goal', 'Gift or Surprise', 'Bucket List', 'Other']
        && request.resource.data.status in ['idea', 'planned', 'completed', 'archived']
        && (!('targetDate' in request.resource.data) || request.resource.data.targetDate == '' || request.resource.data.targetDate.matches('^\\d{4}-\\d{2}-\\d{2}$'))
        && (!('notes' in request.resource.data) || isSafeString(request.resource.data.notes, 1200))
        && (!('convertedMemoryId' in request.resource.data) || isSafeString(request.resource.data.convertedMemoryId, 120))
        && (
          request.resource.data.get('convertedMemoryId', '') == ''
          || exists(memoryDocPath(coupleId, request.resource.data.convertedMemoryId))
        )
        && request.resource.data.createdBy == existingPlanCreatedBy()
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function isSafeStoragePath(value) {
      return value is string
        && value.matches('^couples/[A-Za-z0-9_-]{1,120}/media/[A-Za-z0-9_-]{1,120}/(original|thumbnail|poster)$');
    }

    function isValidMediaMetadata(media, mediaState) {
      return media is map
        && media.keys().hasOnly(['provider', 'id', 'kind', 'storagePath', 'thumbnailPath', 'posterPath', 'driveFileId', 'driveFolderId', 'contentType', 'sizeBytes', 'checksum'])
        && media.id is string
        && media.id.matches('^[A-Za-z0-9_-]{1,120}$')
        && media.kind in ['image', 'video']
        && ((mediaState == 'storage-verified' && (!('provider' in media) || media.provider == 'firebase-storage') && isSafeStoragePath(media.storagePath))
          || (mediaState == 'drive-verified' && media.provider == 'google-drive'
            && media.driveFileId is string && media.driveFileId.matches('^[A-Za-z0-9_-]{10,200}$')
            && media.driveFolderId is string && media.driveFolderId.matches('^[A-Za-z0-9_-]{10,200}$')))
        && (!('thumbnailPath' in media) || media.thumbnailPath == '' || isSafeStoragePath(media.thumbnailPath))
        && (!('posterPath' in media) || media.posterPath == '' || isSafeStoragePath(media.posterPath))
        && media.contentType is string
        && media.contentType.matches('^(image/(jpeg|png|webp|gif)|video/(mp4|quicktime|webm))$')
        && media.sizeBytes is int
        && media.sizeBytes >= 0
        && media.sizeBytes <= 250 * 1024 * 1024
        && media.checksum is string
        && media.checksum.matches('^[A-Fa-f0-9]{64}$');
    }

    function isValidContractAcceptance() {
      return hasOnly(['schemaVersion', 'title', 'bodyStatus', 'acceptedBy', 'signatureStatus'])
        && request.resource.data.schemaVersion == 1
        && (!('title' in request.resource.data) || isSafeString(request.resource.data.title, 160))
        && (!('bodyStatus' in request.resource.data) || isSafeString(request.resource.data.bodyStatus, 60))
        && isValidAcceptedByList(request.resource.data.acceptedBy)
        && request.auth.uid in request.resource.data.acceptedBy
        && request.resource.data.signatureStatus in ['status-only', 'not-connected'];
    }

    function isValidAcceptedByEntry(value) {
      return value is string && value.matches('^[A-Za-z0-9_-]{1,120}$');
    }

    function isValidAcceptedByList(value) {
      return value is list
        && value.size() <= 2
        && (
          value.size() == 0
          || (value.size() == 1 && isValidAcceptedByEntry(value[0]))
          || (value.size() == 2 && isValidAcceptedByEntry(value[0]) && isValidAcceptedByEntry(value[1]))
        );
    }

    function existingAcceptedEntriesRemain() {
      return !(resource.data.acceptedBy is list)
        || (
          (!(resource.data.acceptedBy.size() >= 1) || resource.data.acceptedBy[0] in request.resource.data.acceptedBy)
          && (!(resource.data.acceptedBy.size() >= 2) || resource.data.acceptedBy[1] in request.resource.data.acceptedBy)
        );
    }

    function requestedAcceptedEntriesAreKnown() {
      return !(request.resource.data.acceptedBy is list)
        || (
          (!(request.resource.data.acceptedBy.size() >= 1)
            || request.resource.data.acceptedBy[0] == request.auth.uid
            || (resource.data.acceptedBy is list && request.resource.data.acceptedBy[0] in resource.data.acceptedBy))
          && (!(request.resource.data.acceptedBy.size() >= 2)
            || request.resource.data.acceptedBy[1] == request.auth.uid
            || (resource.data.acceptedBy is list && request.resource.data.acceptedBy[1] in resource.data.acceptedBy))
        );
    }

    function isValidContractAcceptanceUpdate() {
      return isValidContractAcceptance()
        && request.resource.data.get('title', null) == resource.data.get('title', null)
        && request.resource.data.get('bodyStatus', null) == resource.data.get('bodyStatus', null)
        && request.resource.data.get('signatureStatus', null) == resource.data.get('signatureStatus', null)
        && existingAcceptedEntriesRemain()
        && requestedAcceptedEntriesAreKnown();
    }

    function isValidSpecialMoment(momentType) {
      return isApprovedMomentType(momentType)
        && hasOnly(['schemaVersion', 'revision', 'title', 'subtitle', 'date', 'sections'])
        && hasAll(['schemaVersion', 'revision', 'title', 'sections'])
        && request.resource.data.schemaVersion == 1
        && hasNextRevision()
        && isRequiredSafeString(request.resource.data.title, 120)
        && (!('subtitle' in request.resource.data) || isSafeString(request.resource.data.subtitle, 180))
        && (!('date' in request.resource.data) || isDateOrEmpty(request.resource.data.date))
        && request.resource.data.sections is list
        && request.resource.data.sections.size() <= 8;
    }

    match /users/{uid} {
      allow get: if isOwnUser(uid);
      allow list: if false;
      allow create, update, delete: if false;
    }

    match /couples/{coupleId} {
      allow get: if isActiveCoupleMember(coupleId);
      allow list: if false;
      allow create, update, delete: if false;

      match /members/{uid} {
        allow get: if isOwnUser(uid) && isActiveCoupleMember(coupleId);
        allow list: if false;
        allow create, update, delete: if false;
      }

      match /profiles/{uid} {
        allow get, list: if isActiveCoupleMember(coupleId);
        allow create, update: if isActiveCoupleMember(coupleId) && isValidProfile(uid);
        allow delete: if false;
      }

      match /favorites/{uid} {
        allow get, list: if isActiveCoupleMember(coupleId);
        allow create, update: if isActiveCoupleMember(coupleId) && isValidFavorites(uid);
        allow delete: if false;
      }

      match /settings/shared {
        allow get: if isActiveCoupleMember(coupleId);
        allow create, update: if isActiveCoupleMember(coupleId) && isValidSharedSettings();
        allow delete: if false;
      }

      match /settings/{uid} {
        allow get: if isOwnUser(uid) && isActiveCoupleMember(coupleId);
        allow list: if false;
        allow create, update: if isActiveCoupleMember(coupleId) && isValidPrivateSettings(uid);
        allow delete: if false;
      }

      match /contracts/current {
        allow get: if isActiveCoupleMember(coupleId);
        allow create: if isActiveCoupleMember(coupleId) && isValidContractAcceptance();
        allow update: if isActiveCoupleMember(coupleId) && isValidContractAcceptanceUpdate();
        allow delete: if false;
      }

      match /memories/{memoryId} {
        allow get, list: if isActiveCoupleMember(coupleId);
        allow create, update: if isActiveCoupleMember(coupleId) && isValidMemory();
        allow delete: if false;
      }

      match /plans/{planId} {
        allow get, list: if isActiveCoupleMember(coupleId);
        allow create, update: if isActiveCoupleMember(coupleId) && isValidPlan();
        allow delete: if false;
      }

      match /specialMoments/{momentType} {
        allow get: if isApprovedMomentType(momentType) && isActiveCoupleMember(coupleId);
        allow create, update: if isActiveCoupleMember(coupleId) && isValidSpecialMoment(momentType);
        allow list, delete: if false;
      }

      match /{document=**} {
        allow read, write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
