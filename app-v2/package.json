{
  "name": "couplebook-app-v2",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "health:react": "npx -y react-doctor@latest --no-telemetry",
    "lint": "eslint .",
    "test": "node --test",
    "test:browser": "node scripts/check-browser-regression.mjs",
    "test:media-workflows": "npx -y firebase-tools@14.19.0 emulators:exec --only auth,firestore,storage --project couplebook-97830 --config ../firebase.app-v2.json \"node scripts/check-media-workflows.mjs\"",
    "test:performance": "node scripts/check-performance-regression.mjs",
    "test:product": "node scripts/check-product-interactions.mjs",
    "test:owner-ui-review": "npx -y firebase-tools@14.19.0 emulators:exec --only auth,firestore,storage --project couplebook-97830 --config ../firebase.app-v2.json \"node scripts/owner-ui-review.mjs\"",
    "test:visual": "node scripts/check-visual-regression.mjs",
    "test:rules": "node scripts/run-firestore-rules-tests.mjs",
    "test:storage-rules": "node scripts/run-storage-rules-tests.mjs",
    "test:media-mapping": "node src/test/media-mapping.test.js",
    "seed:emulators": "node scripts/seed-local-emulators.mjs",
    "docs:check": "node ../scripts/qa/check-docs.js",
    "product:qa": "node ../scripts/product-qa.mjs",
    "product:audit": "node ../scripts/product-audit.mjs",
    "media:posters": "node scripts/media-generate-posters.mjs",
    "media:dry-run": "node scripts/media-dry-run.mjs",
    "media:apply": "node scripts/media-apply.mjs",
    "migration:plan": "node scripts/plan-firestore-migration.mjs",
    "migration:rehearse": "node scripts/rehearse-firestore-migration.mjs",
    "production:backup": "node scripts/backup-firestore.mjs",
    "migration:package": "node scripts/create-firestore-migration-package.mjs",
    "migration:apply": "node scripts/apply-firestore-migration.mjs",
    "migration:verify": "node scripts/verify-firestore-migration.mjs",
    "migration:rollback": "node scripts/rollback-firestore-migration.mjs"
  },
  "dependencies": {
    "firebase": "^12.17.1",
    "lucide-react": "^0.468.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@tailwindcss/vite": "^4.1.17",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "firebase-admin": "^14.2.0",
    "globals": "^16.5.0",
    "tailwindcss": "^4.1.17",
    "vite": "^7.2.4"
  }
}
